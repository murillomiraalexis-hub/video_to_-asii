import argparse
import os
import time
import cv2
import numpy as np

ASCII_CHARS = " .:-=+*#%@"

def frame_to_ascii(frame, cols=100, use_color=True):
    height, width, _ = frame.shape
    aspect_ratio = height / width
    rows = int(cols * aspect_ratio * 0.5)
    
    resized = cv2.resize(frame, (cols, rows), interpolation=cv2.INTER_AREA)
    gray = cv2.cvtColor(resized, cv2.COLOR_BGR2GRAY)
    
    ascii_frame = []
    for y in range(rows):
        line = ""
        for x in range(cols):
            brightness = gray[y, x]
            char_idx = int((brightness / 255) * (len(ASCII_CHARS) - 1))
            char = ASCII_CHARS[char_idx]
            
            if use_color:
                b, g, r = resized[y, x]
                line += f"\033[38;2;{r};{g};{b}m{char}"
            else:
                line += char
        ascii_frame.append(line + ("\033[0m" if use_color else ""))
        
    return "\n".join(ascii_frame)

def play_video_ascii(video_path, cols=100, use_color=True):
    if not os.path.exists(video_path):
        print(f"Error: No se encontró el archivo '{video_path}'")
        return

    cap = cv2.VideoCapture(video_path)
    fps = cap.get(cv2.CAP_PROP_FPS) or 30
    delay = 1.0 / fps

    os.system('cls' if os.name == 'nt' else 'clear')

    try:
        while cap.isOpened():
            start_time = time.time()
            ret, frame = cap.read()
            if not ret:
                break
            
            ascii_art = frame_to_ascii(frame, cols=cols, use_color=use_color)
            print("\033[H" + ascii_art, end="")
            
            elapsed = time.time() - start_time
            if elapsed < delay:
                time.sleep(delay - elapsed)
    except KeyboardInterrupt:
        pass
    finally:
        cap.release()
        print("\033[0m")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Reproduce videos como arte ASCII en la terminal.")
    parser.add_argument("video", help="Ruta del archivo de video (ej. video.mp4)")
    parser.add_argument("-c", "--cols", type=int, default=100, help="Ancho en caracteres (por defecto: 100)")
    parser.add_argument("--no-color", action="store_true", help="Reproducir en blanco y negro")
    
    args = parser.parse_args()
    play_video_ascii(args.video, cols=args.cols, use_color=not args.no_color)
